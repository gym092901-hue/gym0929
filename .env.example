# Public site URL. Use the Vercel production URL or your custom domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Must be false for production. The app forces demo/review flows off when VERCEL_ENV=production.
# For non-Vercel production hosting, NODE_ENV=production also disables demo/review flows.
DEMO_MODE=false
# Preview/staging only. Set true on a Vercel Preview deployment when sharing a test link that can open the mock-paid premium report flow.
# Must remain false in Vercel Production.
PUBLIC_REVIEW_MODE=false

# Supabase production project
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma / Supabase Postgres connection strings.
# DATABASE_URL is required for Prisma Client generation on Vercel.
# Use the pooled Supabase connection string for serverless runtime.
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Optional. Add this later if you use Prisma Migrate with a direct Supabase connection.
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# KakaoPay online one-time payment
KAKAOPAY_CLIENT_ID=
KAKAOPAY_SECRET_KEY=
KAKAOPAY_CID=
KAKAOPAY_BASE_URL=https://open-api.kakaopay.com

# PayPal Orders API + JavaScript SDK
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Simple admin gate. Replace with Supabase Auth later.
ADMIN_PASSWORD=

# Deployment verification only. Use with `npm run health:prod` after Vercel deploy.
PRODUCTION_BASE_URL=https://your-domain.example
